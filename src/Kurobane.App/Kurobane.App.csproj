<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <PropertyGroup>
    <AssemblyName>Kurobane</AssemblyName>
    <RootNamespace>Kurobane.App</RootNamespace>
    <ApplicationIcon>Assets\Kurobane.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kurobane.Core\Kurobane.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\kurobane-mark.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kurobane.App.Tests" />
  </ItemGroup>
</Project>
