<Window x:Class="Kurobane.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurobane Settings" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Connect to your ZeroClaw gateway" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="Name (label only)" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Gateway address — e.g. http://100.64.0.2:42617 or https://zeroclaw.tail1234.ts.net" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
            <TextBox x:Name="UrlBox" Margin="0,0,0,10"/>

            <TextBlock Text="Agent alias (every WebSocket session is bound to one). Picking one here does not change the gateway." Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2" TextWrapping="Wrap"/>
            <ComboBox x:Name="AgentList" Margin="0,0,0,6" Visibility="Collapsed" SelectionChanged="OnAgentPicked"/>
            <TextBox x:Name="AgentBox" Margin="0,0,0,10"/>

            <TextBlock Text="Pairing code (shown by `zeroclaw gateway pair` or the dashboard)" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
            <PasswordBox x:Name="CodeBox" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="PairButton" Content="Pair and test connection" Style="{StaticResource AccentButton}" Click="OnPair" Margin="0,0,8,0"/>
                <Button x:Name="TestButton" Content="Test connection" Click="OnTest"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,10"/>

            <TextBlock Text="Theme" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
            <ComboBox x:Name="ThemeBox" Margin="0,0,0,10" DisplayMemberPath="DisplayName"/>

            <TextBlock Text="Appearance" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
            <ComboBox x:Name="AppearanceBox" Margin="0,0,0,10">
                <ComboBoxItem Content="System" Tag="system"/>
                <ComboBoxItem Content="Light" Tag="light"/>
                <ComboBoxItem Content="Dark" Tag="dark"/>
            </ComboBox>

            <TextBlock Text="Text size" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
            <ComboBox x:Name="ScaleBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Normal (100%)" Tag="100"/>
                <ComboBoxItem Content="Larger (115%)" Tag="115"/>
                <ComboBoxItem Content="Largest (130%)" Tag="130"/>
            </ComboBox>

            <CheckBox x:Name="UpdateOnStartBox" Content="Check for a new version when Kurobane starts" Margin="0,0,0,10"/>

            <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBlock x:Name="UpdateCurrent" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="UpdateCheck" Content="Check for updates" Click="OnUpdateCheck" Margin="0,0,8,0"/>
                <Button x:Name="UpdateDownload" Content="Download and verify" Click="OnUpdateDownload" Margin="0,0,8,0"/>
                <Button x:Name="UpdateInstall" Content="Install and restart" Click="OnUpdateInstall" Margin="0,0,8,0"/>
                <Button x:Name="UpdatePage" Content="Open release page" Click="OnUpdatePage"/>
            </StackPanel>
            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,12,0,0"
                       Text="Kurobane does not place voice calls and does not receive background or mobile push. Approval balloons only appear while the window is open."/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}" Click="OnSave" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
