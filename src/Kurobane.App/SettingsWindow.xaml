<Window x:Class="Kurobane.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurobane Settings" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Connect to your ZeroClaw gateway" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Name (label only)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Gateway address — e.g. http://100.64.0.2:42617 or https://zeroclaw.tail1234.ts.net" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="UrlBox" Margin="0,0,0,10"/>

            <TextBlock Text="Agent alias (every WebSocket session is bound to one)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="AgentBox" Margin="0,0,0,10"/>

            <TextBlock Text="Pairing code (shown by `zeroclaw gateway pair` or the dashboard)" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2"/>
            <PasswordBox x:Name="CodeBox" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="PairButton" Content="Pair and test connection" Style="{StaticResource AccentButton}" Click="OnPair" Margin="0,0,8,0"/>
                <Button x:Name="TestButton" Content="Test connection" Click="OnTest"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>

            <TextBlock Text="Appearance" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2"/>
            <ComboBox x:Name="AppearanceBox" Margin="0,0,0,10">
                <ComboBoxItem Content="Dark" Tag="dark"/>
                <ComboBoxItem Content="Light" Tag="light"/>
                <ComboBoxItem Content="System" Tag="system"/>
            </ComboBox>

            <TextBlock Text="Text size" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,2"/>
            <ComboBox x:Name="ScaleBox">
                <ComboBoxItem Content="Normal (100%)" Tag="100"/>
                <ComboBoxItem Content="Larger (115%)" Tag="115"/>
                <ComboBoxItem Content="Largest (130%)" Tag="130"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}" Click="OnSave" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
