<Window x:Class="Kurobane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurobane" Icon="pack://application:,,,/Assets/kurobane-mark.png" Width="1180" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Click="OnOpenSettings"
                Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.OnAccent}"
                BorderThickness="0" Padding="10,6" HorizontalContentAlignment="Center"/>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource Brush.SurfaceSidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="4,8,4,8">
                    <Button x:Name="SidebarToggle" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="SidebarToggle_Click" Width="32" Height="32"
                            ToolTip="Hide the sidebar (Ctrl+B)" AutomationProperties.Name="Hide sidebar">
                        <TextBlock Text="&#xE8A0;" FontFamily="{StaticResource Font.Icons}" FontSize="14"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#F4EDD9" BorderBrush="#1B3A5A" BorderThickness="1" Margin="0,0,9,0">
                            <Viewbox Margin="3">
                                <Grid Width="24" Height="24">
                                    <Path Fill="#141210" Stroke="#A63F2D" StrokeThickness="0.6"
                                          Data="M11.2,22 C9.6,17 6.4,13 8.2,8.4 C9.2,5.6 12.2,3.2 15.6,2.8 C18.4,5.6 18.8,9.6 16.4,13.2 C14,17 12.4,19.8 11.2,22 Z"/>
                                    <Path Stroke="#F4EDD9" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M14.6,4.2 C13.2,8.6 11.8,13.6 10.4,20"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Kurobane" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                    <TextBlock x:Name="ServerLabel" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Margin="6,0,6,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AliasNotice" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Margin="6,0,6,8" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button x:Name="NewChatButton" Style="{StaticResource AccentButton}" Click="OnNewChat"
                            Margin="0,0,0,8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="SessionSearch" Margin="0,0,0,8" ToolTip="Search sessions on this gateway"
                             TextChanged="OnSearchChanged"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,4">
                    <Button x:Name="NeedsYouButton" Style="{StaticResource NavRowButton}" Click="OnNeedsYou">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" Style="{StaticResource NavGlyph}"/><TextBlock x:Name="NeedsYouText" Text="Needs you"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="ForegroundNote" TextWrapping="Wrap" FontSize="12" Margin="10,0,8,8"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               Text="Approval notices are a foreground notification while Kurobane is open, not reliable background delivery."/>
                    <Button x:Name="RefreshButton" Style="{StaticResource NavRowButton}" Click="OnRefresh">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Refresh sessions"/></StackPanel>
                    </Button>
                    <Button x:Name="RenameButton" Style="{StaticResource NavRowButton}" Click="OnRename">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Rename session"/></StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource NavRowButton}" Click="OnDelete">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Delete session"/></StackPanel>
                    </Button>
                    <Button x:Name="AbortButton" Style="{StaticResource NavRowButton}" Click="OnAbort">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Abort running turn"/></StackPanel>
                    </Button>
                    <Button x:Name="LabelButton" Style="{StaticResource NavRowButton}" Click="OnLabel">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Label on this PC"/></StackPanel>
                    </Button>
                    <Button x:Name="ModeButton" Style="{StaticResource NavRowButton}" Click="OnToggleMode">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}"/><TextBlock x:Name="ModeText" Text="Advanced"/></StackPanel>
                    </Button>
                    <StackPanel x:Name="AdvancedNav" Visibility="Collapsed">
                        <Button Style="{StaticResource NavRowButton}" Click="OnPageAgent" Content="This agent"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPageSkills" Content="Skills"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPageTools" Content="Tools"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPageJobs" Content="Jobs"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPageMemory" Content="Memory"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPageUsage" Content="Usage"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPagePlugins" Content="Plugins"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPagePersonality" Content="Personality"/>
                        <Button Style="{StaticResource NavRowButton}" Click="OnPageDevices" Content="Paired devices"/>
                        <Button x:Name="ConfigButton" Style="{StaticResource NavRowButton}" Click="OnOpenConfig">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Gateway config"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <Button x:Name="SettingsButton" Style="{StaticResource NavRowButton}" Click="OnOpenSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Settings"/></StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Style="{StaticResource QuietScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="SessionList" SelectionChanged="OnSessionSelected" MouseDoubleClick="OnSessionDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ConversationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="8,6,16,0" MinHeight="32">
                <Button x:Name="SidebarOpenNarrow" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Click="SidebarToggle_Click" Width="32" Height="32" Visibility="Collapsed"
                        ToolTip="Show the sidebar (Ctrl+B)" AutomationProperties.Name="Open sidebar">
                    <TextBlock Text="&#xE89F;" FontFamily="{StaticResource Font.Icons}" FontSize="14"/>
                </Button>
            </DockPanel>
            <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid x:Name="ChatView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ChatTitle" Text="No session selected" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="PcCaption" Grid.Row="1" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap"/>
                <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Large}">
                    <ScrollViewer x:Name="ChatScroll" Style="{StaticResource QuietScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="6">
                        <StackPanel x:Name="MessagesPanel" Margin="8"/>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="RunStatus" Grid.Row="3" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                           Margin="2,8,0,4" Text=""/>
                <TextBlock x:Name="AttachNote" Grid.Row="4" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                           Margin="2,0,0,6" TextWrapping="Wrap"/>
                <Border Grid.Row="5" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Large}" Padding="6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AttachButton" Style="{StaticResource IconButton}" Click="OnAttach" Width="32" Height="32"
                                VerticalAlignment="Bottom" Margin="2,0,2,2" ToolTip="Attach a PNG, JPEG, GIF, or WebP image"
                                AutomationProperties.Name="Attach image">
                            <TextBlock Text="&#xE723;" FontFamily="{StaticResource Font.Icons}" FontSize="14"/>
                        </Button>
                        <TextBox x:Name="Composer" Grid.Column="1" Style="{StaticResource ComposerBareBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="36" MaxHeight="160" VerticalScrollBarVisibility="Auto" KeyDown="OnComposerKeyDown"/>
                        <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource SendButton}" Click="OnSend"
                                Width="32" Height="32" VerticalAlignment="Bottom" Margin="4,0,2,2"
                                ToolTip="Send (Enter; Shift+Enter for a new line)" AutomationProperties.Name="Send">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource Font.Icons}" FontSize="14"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="AdvancedView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Back to chat" Click="OnBackToChat" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AdvancedTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="Changes ask first. Scheduled jobs and personality files are written only after you confirm. The config editor sets one property at a time and refuses a masked secret. Kurobane does not change the provider or model unless you edit that property yourself."/>
                <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Large}">
                    <ScrollViewer Style="{StaticResource QuietScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel x:Name="AdvancedBody"/>
                    </ScrollViewer>
                </Border>
            </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
