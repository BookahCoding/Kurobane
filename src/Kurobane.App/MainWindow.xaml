<Window x:Class="Kurobane.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurobane" Icon="pack://application:,,,/Assets/Kurobane.ico" Width="1180" Height="760" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Click="OnOpenSettings"
                Background="{DynamicResource Brush.Accent}" Foreground="{DynamicResource Brush.OnAccent}"
                BorderThickness="0" Padding="10,6" HorizontalContentAlignment="Center"/>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Hikyaku shape — brand, server, New chat, then scrolling session list, then nav rows -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceSidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="4,8,4,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App mark: washi-paper K on vermilion, drawn as vectors so it stays sharp -->
                        <Border Width="22" Height="22" CornerRadius="6" Background="#A63F2D" Margin="0,0,9,0">
                            <Viewbox Margin="4">
                                <Path Fill="#F4EDD9" Data="M20,14h8a5,5 0,0 1,5 5a5,5 0,0 1,-5 5h-8a5,5 0,0 1,-5 -5a5,5 0,0 1,5 -5z M22,26l16,22h-8l-13,-18z M38,26l-14,19h-8l14,-19z"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Kurobane" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                    <TextBlock x:Name="ServerLabel" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                               Margin="6,0,6,8" TextWrapping="Wrap"/>
                    <Button x:Name="NewChatButton" Style="{StaticResource AccentButton}" Click="OnNewChat"
                            Margin="0,0,0,8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,4">
                    <Button x:Name="RefreshButton" Style="{StaticResource NavRowButton}" Click="OnRefresh">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Refresh sessions"/></StackPanel>
                    </Button>
                    <Button x:Name="RenameButton" Style="{StaticResource NavRowButton}" Click="OnRename">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Rename session"/></StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource NavRowButton}" Click="OnDelete">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Delete session"/></StackPanel>
                    </Button>
                    <Button x:Name="AbortButton" Style="{StaticResource NavRowButton}" Click="OnAbort">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Abort running turn"/></StackPanel>
                    </Button>
                    <Button x:Name="ConfigButton" Style="{StaticResource NavRowButton}" Click="OnOpenConfig">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Gateway config"/></StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource NavRowButton}" Click="OnOpenSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}"/><TextBlock Text="Settings"/></StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Style="{StaticResource QuietScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="SessionList" SelectionChanged="OnSessionSelected" MouseDoubleClick="OnSessionDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ConversationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} messages · {1:g}">
                                                <Binding Path="MessageCount"/>
                                                <Binding Path="LastActivity"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Chat: header, scrolling transcript, status line, rounded composer card -->
        <Grid Grid.Column="1" Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="ChatTitle" Text="No session selected" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Large}">
                <ScrollViewer x:Name="ChatScroll" Style="{StaticResource QuietScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel x:Name="MessagesPanel" Margin="8"/>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="RunStatus" Grid.Row="2" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                       Margin="2,8,0,8" Text=""/>
            <Border Grid.Row="3" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Large}" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Composer" Style="{StaticResource ComposerBareBox}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="36" MaxHeight="160" VerticalScrollBarVisibility="Auto" KeyDown="OnComposerKeyDown"/>
                    <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource SendButton}" Click="OnSend"
                            Width="32" Height="32" VerticalAlignment="Bottom" Margin="4,0,2,2"
                            ToolTip="Send (Enter; Shift+Enter for a new line)" AutomationProperties.Name="Send">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource Font.Icons}" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
